# GitHub Personal Access Token (Read-Only)
# Required for fetching the GitHub Contribution Calendar via GraphQL API.
#
# Permissions needed:
# - Classic Token: No scopes required (grants read-only access to public profile data)
# - Fine-Grained Token: Public Repositories (read-only) or User Profile (read-only)
# NO REPO WRITE ACCESS REQUIRED.
#
# Generate one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Resend API Key (Get free key from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here
CONTACT_RECEIVER_EMAIL=your_email@example.com
